# Database connection string (e.g. from Vercel Postgres, Supabase, Neon)
DATABASE_URL="postgresql://user:password@host:port/database"

# Vercel Blob Storage Token (required for uploading images to the database through the admin interface)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secure password for the admin interface (must match what's typed in the login screen)
ADMIN_PASSWORD="super-secret-password-here"
